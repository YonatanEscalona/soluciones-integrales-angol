---
import Layout from '../layouts/Layout.astro';
import HousePlanner from '../components/HousePlanner.astro';
import BudgetRequest from '../components/BudgetRequest.astro';

const whatsapp = 'https://wa.me/56935172731';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
const modelos = [
  {
    title: 'Casa tradicional en madera',
    type: 'CASA TRADICIONAL',
    description: 'Cubierta inclinada, madera a la vista y una terraza para disfrutar el exterior.',
    image: '/images/modelo-casa-tradicional.webp',
    alt: 'Casa referencial de madera con techo inclinado y terraza frontal',
  },
  {
    title: 'Casa modular en madera',
    type: 'CASA MODULAR',
    description: 'Un diseño horizontal que combina madera natural y revestimiento oscuro.',
    image: '/images/modelo-modular-madera.webp',
    alt: 'Casa modular referencial con revestimiento de madera y fachada oscura',
  },
  {
    title: 'Módulo compacto',
    type: 'ESPACIO COMPACTO',
    description: 'Una propuesta de menor escala, luminosa y de líneas simples.',
    image: '/images/modelo-modulo-compacto.webp',
    alt: 'Módulo compacto referencial con fachada oscura, listones de madera y puerta vidriada',
  },
  {
    title: 'Quincho en madera',
    type: 'QUINCHO',
    image: '/images/modelo-quincho-madera.webp',
    alt: 'Quincho referencial de madera con cubierta de zinc, parrilla de ladrillo y radier de hormigón en un jardín del sur de Chile',
  },
  {
    title: 'Casa con terraza',
    type: 'OBRA DEL PORTAFOLIO',
    image: '/images/obra-casa-verde-hd.webp',
    alt: 'Casa de fachada verde con cubierta inclinada y terraza, fotografía del portafolio mejorada con IA',
    width: 1380,
    height: 1140,
    real: true,
  },
  {
    title: 'Interior en madera',
    type: 'OBRA DEL PORTAFOLIO',
    image: '/images/obra-interior-madera-hd.webp',
    alt: 'Interior de casa revestido en madera con ventanales, fotografía del portafolio mejorada con IA',
    width: 1763,
    height: 892,
    real: true,
  },
];
---

<Layout
  title="Construcción de casas, quinchos y radieres en Angol | Soluciones Integrales"
  description="Construimos casas, quinchos y radieres en Angol y La Araucanía. Explora modelos y obras, y cotiza tu proyecto por WhatsApp."
>
  <header class="site-header">
    <div class="header-inner">
      <a class="brand" href="#inicio" aria-label="Soluciones Integrales, ir al inicio">
        <img src={asset('/images/logo-soluciones-integrales.png')} alt="" width="640" height="514" decoding="async" />
        <span><strong>Soluciones Integrales</strong><small>Construcción profesional · Angol</small></span>
      </a>
      <nav class="desktop-nav" aria-label="Navegación principal">
        <a href="#obras">Proyectos</a>
        <a href="#servicios">Servicios</a>
        <a href="#planifica">Planifica tu casa</a>
        <a href="#contacto">Contacto</a>
      </nav>
      <a class="header-cta" href={whatsapp} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
      <details class="mobile-menu">
        <summary>Menú <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></summary>
        <nav class="mobile-nav" aria-label="Navegación móvil">
          <a href="#obras">Proyectos</a>
          <a href="#servicios">Servicios</a>
          <a href="#planifica">Planifica tu casa</a>
          <a href="#contacto">Contacto</a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a>
        </nav>
      </details>
    </div>
  </header>
  <main id="inicio">
    <div class="hero-layout">
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-photo" src={asset('/images/hero-casa-chilena.webp')} alt="Imagen ilustrativa de una casa chilena contemporánea de estuco claro, cubierta metálica y detalles en madera" width="1672" height="940" loading="eager" fetchpriority="high" decoding="async" />
        <div class="hero-content">
          <h1 id="hero-title">Encuentra tu<br />casa <em>ideal.</em></h1>
          <p>Construimos casas, quinchos y radieres en Angol y La Araucanía. Conversemos sobre el proyecto que tienes en mente.</p>
          <div class="hero-actions">
            <a class="button button-dark" href={whatsapp} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M8 5h11v11" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            <a class="button button-outline" href="#obras">Ver obras</a>
          </div>
          <ul class="hero-services" aria-label="Servicios principales"><li>Casas modulares</li><li>Casas tradicionales</li><li>Radieres</li></ul>
        </div>
      </section>

      <form class="quote-bar" id="hero-quote-form" aria-label="Cotiza tu proyecto por WhatsApp">
        <div class="quote-heading"><strong>Tu proyecto empieza aquí</strong><span>Cuéntanos qué quieres construir</span></div>
        <div class="quote-fields">
          <div class="field">
            <label for="project-type">Tipo de proyecto</label>
            <select id="project-type" name="project-type" required>
              <option value="" disabled selected>Seleccionar</option>
              <option value="Casa llave en mano">Casa llave en mano</option>
              <option value="Casa modular">Casa modular</option>
              <option value="Casa tradicional">Casa tradicional</option>
              <option value="Quincho">Quincho</option>
              <option value="Radier">Radier</option>
              <option value="Aún estoy explorando">Aún estoy explorando</option>
            </select>
          </div>
          <div class="field"><label for="project-location">Comuna del proyecto</label><input id="project-location" name="project-location" type="text" autocomplete="address-level2" placeholder="Ej. Angol" maxlength="80" required /></div>
          <button class="quote-submit" type="submit">Cotizar por WhatsApp <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
        <noscript><a href={whatsapp}>También puedes escribirnos directamente por WhatsApp.</a></noscript>
      </form>
      <a class="planner-shortcut" href="#planifica">¿Tienes una idea? Planifica tu casa aquí</a>
    </div>

  </main>

  <section class="works" id="obras" aria-labelledby="works-title">
    <div class="works-stage">
      <div class="works-inner">
        <div class="works-intro">
          <h2 id="works-title">Algunas de <em>nuestras obras.</em></h2>
          <div class="works-progress" aria-hidden="true"><span id="works-current">01</span><span class="works-progress-line"></span><span>0{modelos.length}</span></div>
          <span class="works-scroll-cue" aria-hidden="true">Desplázate para explorar</span>
        </div>
        <div class="works-viewport" aria-label="Modelos de casas y quinchos, y obras del portafolio">
          <div class="works-track">
            {modelos.map((modelo, index) => (
              <article class="work-card">
                <img src={asset(modelo.image)} alt={modelo.alt} width={modelo.width ?? 1536} height={modelo.height ?? 1024} loading="lazy" decoding="async" />
                <div class="work-card-caption">
                  <span class="work-card-number">0{index + 1}</span>
                  <div><span class="work-card-detail">{modelo.type}{!modelo.real && ' · REFERENCIAL'}</span><h3>{modelo.title}</h3></div>
                  <a href={`${whatsapp}?text=${encodeURIComponent(`Hola, me gustaría cotizar ${modelo.type === 'QUINCHO' ? 'un quincho' : 'una casa'} con Soluciones Integrales. Me interesa ${modelo.title}.`)}`} target="_blank" rel="noopener noreferrer" aria-label={`Cotizar un proyecto de ${modelo.title} por WhatsApp`}>Cotizar</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-section" id="servicios" aria-labelledby="feature-title">
    <div class="feature-heading">
      <h2 id="feature-title">Construimos contigo.</h2>
      <p>Casas, quinchos y radieres para darle forma a tu próximo proyecto.</p>
    </div>
    <div class="feature-grid">
      <a class="feature-card feature-card--primary" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero cotizar la construcción de una casa con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-casas.webp')} alt="" width="1122" height="1402" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Construimos<br />tu casa.</h3>
          <p>Casas tradicionales y modulares, pensadas para tu proyecto.</p>
          <span class="feature-action">Cotizar una casa</span>
        </div>
      </a>
      <a class="feature-card feature-card--wide" href="#obras">
        <img src={asset('/images/servicio-modelos.webp')} alt="" width="1774" height="887" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Casas para<br />inspirarte.</h3>
          <span class="feature-action">Ver modelos</span>
        </div>
      </a>
      <a class="feature-card feature-card--radier" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero cotizar la construcción de un radier con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-radieres.webp')} alt="" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Radieres.</h3>
          <span class="feature-action">Cotizar radier</span>
        </div>
      </a>
      <a class="feature-card feature-card--quincho" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero cotizar la construcción de un quincho con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-quinchos.webp')} alt="" width="1536" height="1024" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Quinchos.</h3>
          <span class="feature-action">Cotizar quincho</span>
        </div>
      </a>
    </div>
    <div class="turnkey-band">
      <div><h3>Construcción llave en mano.</h3><p>Desde la estructura hasta las terminaciones, con un equipo que coordina tu proyecto. Definimos contigo los materiales, las partidas y el alcance que incluirá tu presupuesto.</p></div>
      <a class="button button-dark" href="#contacto">Solicitar presupuesto</a>
    </div>
  </section>

  <HousePlanner />

  <section class="project-section" aria-labelledby="project-title">
    <div class="project-inner">
      <div class="project-intro">
        <h2 id="project-title">De la idea a un proyecto concreto.</h2>
        <p>Cuéntanos qué quieres construir y dónde. Con esos datos podemos empezar a conversar sobre tu proyecto.</p>
      </div>
      <ol class="project-steps">
        <li><span class="step-number">01</span><div><h3>Comparte tu idea</h3><p>Una casa, un quincho o un radier. Cuéntanos la comuna y comparte tu dibujo, medidas o referencias.</p></div></li>
        <li><span class="step-number">02</span><div><h3>Definimos el presupuesto</h3><p>Revisamos lo que necesitas y acordamos los materiales, las partidas y las terminaciones de tu proyecto.</p></div></li>
        <li><span class="step-number">03</span><div><h3>Construimos lo acordado</h3><p>Con el alcance definido, coordinamos la ejecución y los detalles de la obra.</p></div></li>
      </ol>
    </div>
  </section>

  <BudgetRequest />

  <footer class="site-footer">
    <div class="footer-inner">
      <div><strong>Soluciones Integrales</strong><span>Construcción de casas, quinchos y radieres.</span></div>
      <div><span>Angol · La Araucanía</span><a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp +56 9 3517 2731</a></div>
    </div>
  </footer>

  <script>
    const mobileMenu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
    if (mobileMenu) {
      mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => mobileMenu.removeAttribute('open')));
      mobileMenu.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') {
          mobileMenu.removeAttribute('open');
          mobileMenu.querySelector('summary')?.focus();
        }
      });
    }

    const quoteForm = document.querySelector<HTMLFormElement>('#hero-quote-form');
    quoteForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!quoteForm.reportValidity()) return;
      const type = quoteForm.querySelector<HTMLSelectElement>('#project-type')?.value.trim() ?? '';
      const location = quoteForm.querySelector<HTMLInputElement>('#project-location')?.value.trim() ?? '';
      const message = `Hola, quiero cotizar un proyecto con Soluciones Integrales. Tipo: ${type}. Comuna: ${location}.`;
      window.open(`https://wa.me/56935172731?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });

    const works = document.querySelector<HTMLElement>('#obras');
    const worksViewport = works?.querySelector<HTMLElement>('.works-viewport');
    const worksTrack = works?.querySelector<HTMLElement>('.works-track');
    const worksCurrent = document.querySelector<HTMLElement>('#works-current');
    if (works && worksViewport && worksTrack) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const mobileWorks = window.matchMedia('(max-width: 760px), (hover: none) and (pointer: coarse)');
      const scrollCue = works.querySelector<HTMLElement>('.works-scroll-cue');
      let travel = 0;
      let frame = 0;

      const setProgress = (value: number) => {
        const progress = Math.min(1, Math.max(0, value));
        works.style.setProperty('--works-progress', String(Math.max(.08, progress)));
        if (worksCurrent) worksCurrent.textContent = String(Math.min(worksTrack.children.length, Math.floor(progress * worksTrack.children.length) + 1)).padStart(2, '0');
      };

      const update = () => {
        frame = 0;
        if (!works.classList.contains('is-scroll-driven')) return;
        const scrollable = Math.max(1, works.offsetHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, -works.getBoundingClientRect().top / scrollable));
        worksTrack.style.transform = `translate3d(${-Math.round(travel * progress)}px, 0, 0)`;
        setProgress(progress);
      };

      const requestUpdate = () => {
        if (!frame) frame = window.requestAnimationFrame(update);
      };

      const measure = () => {
        if (reducedMotion.matches || mobileWorks.matches) {
          works.classList.remove('is-scroll-driven');
          works.style.removeProperty('--scroll-distance');
          worksTrack.style.removeProperty('transform');
          if (scrollCue) scrollCue.textContent = 'Desliza las obras hacia un lado';
          setProgress(worksViewport.scrollLeft / Math.max(1, worksTrack.scrollWidth - worksViewport.clientWidth));
          return;
        }
        worksViewport.scrollLeft = 0;
        if (scrollCue) scrollCue.textContent = 'Desplázate para explorar';
        works.classList.add('is-scroll-driven');
        travel = Math.max(0, worksTrack.scrollWidth - worksViewport.clientWidth);
        works.style.setProperty('--scroll-distance', `${Math.max(travel * 2.4, window.innerHeight * (worksTrack.children.length - 1))}px`);
        requestUpdate();
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      worksViewport.addEventListener('scroll', () => {
        if (!works.classList.contains('is-scroll-driven')) setProgress(worksViewport.scrollLeft / Math.max(1, worksTrack.scrollWidth - worksViewport.clientWidth));
      }, { passive: true });
      window.addEventListener('resize', measure, { passive: true });
      reducedMotion.addEventListener('change', measure);
      window.requestAnimationFrame(measure);
    }

    const projectSteps = document.querySelectorAll<HTMLElement>('.project-steps li');
    if (projectSteps.length && 'IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      }, { threshold: 0.35 });
      projectSteps.forEach((step) => observer.observe(step));
    }
  </script>
</Layout>

<style>
  :global(body) { margin: 0; --ink: #171916; --ink-raised: #242720; --muted: #555954; --paper: #fff; --paper-light: #fff; --line: #d4d6d2; --yellow: #f3bd1c; --yellow-bright: #ffd33f; }
  :global(*:focus-visible) { outline: 3px solid var(--ink); outline-offset: 3px; }
  .site-header { position: relative; z-index: 20; background: #0d0f0d; border-bottom: 1px solid rgb(255 255 255 / .15); }
  .header-inner { position: relative; display: flex; align-items: center; gap: 28px; max-width: 1536px; min-height: 74px; margin: 0 auto; padding: 8px clamp(16px, 3.5vw, 56px); }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; margin-right: auto; color: #fff; text-decoration: none; }
  .brand img { display: block; flex: none; width: 59px; height: 50px; object-fit: contain; }
  .brand span { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .brand strong { font-size: 16px; font-weight: 700; letter-spacing: -.03em; line-height: 1.05; white-space: nowrap; }
  .brand small { color: var(--paper); font-size: 10px; font-weight: 700; letter-spacing: .04em; line-height: 1.2; white-space: nowrap; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(16px, 2.7vw, 36px); }
  .desktop-nav a { color: #fff; font-size: 13px; font-weight: 600; text-decoration: none; text-underline-offset: 5px; }
  .desktop-nav a:hover { text-decoration: underline; }
  .header-cta { display: inline-flex; align-items: center; justify-content: center; min-height: 42px; padding: 0 17px; border-radius: 8px; background: var(--yellow); color: var(--ink); font-size: 12px; font-weight: 700; text-decoration: none; white-space: nowrap; transition: background-color 180ms ease-out; }
  .header-cta:hover { background: var(--yellow-bright); }
  .mobile-menu { display: none; }
  main { background: var(--paper-light); min-height: 100svh; padding: 16px clamp(16px, 3.5vw, 56px) 64px; }
  .hero-layout { max-width: 1424px; margin: 0 auto; }
  .planner-shortcut { display: block; width: fit-content; margin: 24px auto 0; color: var(--ink); font-size: 13px; font-weight: 600; text-align: center; text-underline-offset: 5px; padding: 8px; }
  .hero { min-height: clamp(620px, 69vh, 740px); position: relative; isolation: isolate; overflow: hidden; border-radius: 24px; background: #0b0e0c; }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; z-index: 0; }
  .hero::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(90deg, rgb(11 14 12 / .87) 0%, rgb(11 14 12 / .69) 42%, rgb(11 14 12 / .23) 78%, rgb(11 14 12 / .15) 100%); }
  .hero-content { position: relative; z-index: 2; padding: clamp(50px, 6vw, 100px) clamp(32px, 5.2vw, 84px) 126px; width: min(100%, 820px); }
  h1 { margin: 0; color: #fff; font-size: clamp(54px, 6.3vw, 94px); font-weight: 500; letter-spacing: -.04em; line-height: 1.04; }
  h1 em { color: var(--yellow); font-style: normal; font-weight: 750; }
  .hero-content p { margin: 26px 0 0; max-width: 44ch; color: rgb(255 255 255 / .88); font-size: clamp(15px, 1.3vw, 18px); line-height: 1.5; font-weight: 500; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 17px; min-height: 46px; padding: 12px 19px; border-radius: 8px; text-decoration: none; font-size: 13px; line-height: 1.2; font-weight: 700; transition: background-color 180ms ease-out, color 180ms ease-out; }
  .button-dark { background: var(--yellow); color: var(--ink); }
  .button-dark:hover { background: var(--yellow-bright); }
  .button-outline { border: 1.5px solid #fff; color: #fff; background: transparent; }
  .button-outline:hover { background: rgb(255 255 255 / .15); }
  .button svg { width: 16px; height: 16px; flex: none; }
  .hero-services { display: flex; align-items: center; flex-wrap: wrap; gap: 0; list-style: none; padding: 0; margin: clamp(42px, 6vh, 66px) 0 0; color: #fff; font-size: 13px; font-weight: 700; }
  .hero-services li { padding: 0 16px; line-height: 1.4; border-left: 1px solid rgb(255 255 255 / .5); }
  .hero-services li:first-child { padding-left: 0; border-left: 0; }
  .quote-bar { width: min(850px, calc(100% - 36px)); margin: -61px auto 0; padding: 25px 28px 28px; position: relative; z-index: 2; border-radius: 14px; background: #fff; color: var(--ink); box-shadow: 0 13px 25px rgb(15 17 14 / .13); }
  .quote-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .quote-heading strong { font-size: 17px; font-weight: 700; letter-spacing: -.025em; }
  .quote-heading span { font-size: 12px; color: var(--muted); }
  .quote-fields { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .field label { font-size: 11px; font-weight: 700; color: var(--ink-raised); }
  .field select, .field input { height: 45px; width: 100%; min-width: 0; padding: 0 12px; border: 1px solid var(--line); border-radius: 7px; color: var(--ink); background: #fff; font: inherit; font-size: 13px; transition: border-color 180ms ease-out; }
  .field select { cursor: pointer; }
  .field input::placeholder { color: var(--muted); opacity: 1; }
  .field :is(select, input):hover, .field :is(select, input):focus { border-color: #8b6812; }
  .quote-submit { display: inline-flex; justify-content: center; align-items: center; gap: 12px; height: 45px; padding: 0 18px; border: 0; border-radius: 7px; background: var(--yellow); color: var(--ink); font: inherit; font-size: 12px; font-weight: 700; white-space: nowrap; cursor: pointer; transition: background-color 180ms ease-out; }
  .quote-submit:hover { background: var(--yellow-bright); }
  .quote-submit svg { width: 17px; height: 17px; }
  noscript a { display: inline-block; margin-top: 12px; font-size: 12px; color: var(--ink); }
  .works { background: var(--ink); color: #fff; }
  .works-stage { min-height: 100svh; display: flex; align-items: center; }
  .works.is-scroll-driven { height: calc(100svh + var(--scroll-distance, 1500px)); }
  .works.is-scroll-driven .works-stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .works-inner { width: 100%; max-width: 1536px; margin: 0 auto; padding: 65px clamp(20px, 3.5vw, 56px); display: grid; grid-template-columns: minmax(270px, .8fr) minmax(0, 1.5fr); gap: clamp(30px, 5vw, 80px); align-items: center; }
  .works-intro { min-width: 0; }
