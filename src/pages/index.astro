---
import Layout from '../layouts/Layout.astro';

const whatsapp = 'https://wa.me/56935172731';
const asset = (path: string) => `${import.meta.env.BASE_URL.replace(/\/$/, '')}${path}`;
const modelos = [
  {
    title: 'Casa tradicional en madera',
    type: 'CASA TRADICIONAL',
    description: 'Cubierta inclinada, madera a la vista y una terraza para disfrutar el exterior.',
    image: '/images/modelo-casa-tradicional.webp',
    alt: 'Casa referencial de madera con techo inclinado y terraza frontal',
  },
  {
    title: 'Casa modular en madera',
    type: 'CASA MODULAR',
    description: 'Un diseño horizontal que combina madera natural y revestimiento oscuro.',
    image: '/images/modelo-modular-madera.webp',
    alt: 'Casa modular referencial con revestimiento de madera y fachada oscura',
  },
  {
    title: 'Módulo compacto',
    type: 'ESPACIO COMPACTO',
    description: 'Una propuesta de menor escala, luminosa y de líneas simples.',
    image: '/images/modelo-modulo-compacto.webp',
    alt: 'Módulo compacto referencial con fachada oscura, listones de madera y puerta vidriada',
  },
  {
    title: 'Casa con terraza',
    type: 'OBRA DEL PORTAFOLIO',
    image: '/images/obra-casa-verde-hd.webp',
    alt: 'Casa de fachada verde con cubierta inclinada y terraza, fotografía del portafolio mejorada con IA',
    width: 1380,
    height: 1140,
    real: true,
  },
  {
    title: 'Interior en madera',
    type: 'OBRA DEL PORTAFOLIO',
    image: '/images/obra-interior-madera-hd.webp',
    alt: 'Interior de casa revestido en madera con ventanales, fotografía del portafolio mejorada con IA',
    width: 1763,
    height: 892,
    real: true,
  },
];
---

<Layout
  title="Construcción de casas y radieres en Angol | Soluciones Integrales"
  description="Construimos casas y radieres en Angol y La Araucanía. Conoce nuestros trabajos y conversemos sobre tu proyecto."
  theme="light"
>
  <main>
    <div class="hero-layout">
      <section class="hero" aria-labelledby="hero-title">
        <img class="hero-photo" src={asset('/images/hero-casa-chilena.webp')} alt="Imagen ilustrativa de una casa chilena contemporánea de estuco claro, cubierta metálica y detalles en madera" width="1672" height="940" loading="eager" fetchpriority="high" decoding="async" />
        <div class="hero-content">
          <h1 id="hero-title">Encuentra tu<br />casa <em>ideal.</em></h1>
          <p>Construimos casas y radieres en Angol y La Araucanía. Conversemos sobre el proyecto que tienes en mente.</p>
          <div class="hero-actions">
            <a class="button button-dark" href={whatsapp} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp <span aria-hidden="true">↗</span></a>
            <a class="button button-outline" href="#obras">Ver obras <span aria-hidden="true">↗</span></a>
          </div>
          <ul class="hero-services" aria-label="Servicios principales"><li>Casas modulares</li><li>Casas tradicionales</li><li>Radieres</li></ul>
        </div>
      </section>

      <form class="quote-bar" id="hero-quote-form" aria-label="Cotiza tu proyecto por WhatsApp">
        <div class="quote-heading"><strong>Tu proyecto empieza aquí</strong><span>Cuéntanos qué quieres construir</span></div>
        <div class="quote-fields">
          <div class="field">
            <label for="project-type">Tipo de proyecto</label>
            <select id="project-type" name="project-type" required>
              <option value="" disabled selected>Seleccionar</option>
              <option value="Casa modular">Casa modular</option>
              <option value="Casa tradicional">Casa tradicional</option>
              <option value="Radier">Radier</option>
              <option value="Aún estoy explorando">Aún estoy explorando</option>
            </select>
          </div>
          <div class="field"><label for="project-location">Comuna del proyecto</label><input id="project-location" name="project-location" type="text" autocomplete="address-level2" placeholder="Ej. Angol" maxlength="80" required /></div>
          <button class="quote-submit" type="submit">Cotizar por WhatsApp <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
        </div>
        <noscript><a href={whatsapp}>También puedes escribirnos directamente por WhatsApp.</a></noscript>
      </form>
    </div>

  </main>

  <section class="works" id="obras" aria-labelledby="works-title">
    <div class="works-stage">
      <div class="works-inner">
        <div class="works-intro">
          <h2 id="works-title">Algunas de <em>nuestras obras.</em></h2>
          <div class="works-progress" aria-hidden="true"><span id="works-current">01</span><span class="works-progress-line"></span><span>0{modelos.length}</span></div>
          <span class="works-scroll-cue" aria-hidden="true">Desplázate para explorar <span>→</span></span>
        </div>
        <div class="works-viewport" aria-label="Modelos y obras de casas">
          <div class="works-track">
            {modelos.map((modelo, index) => (
              <article class="work-card">
                <img src={asset(modelo.image)} alt={modelo.alt} width={modelo.width ?? 1536} height={modelo.height ?? 1024} loading="lazy" decoding="async" />
                <div class="work-card-caption">
                  <span class="work-card-number">0{index + 1}</span>
                  <div><span class="work-card-detail">{modelo.type}{!modelo.real && ' · REFERENCIAL'}</span><h3>{modelo.title}</h3></div>
                  <a href={`${whatsapp}?text=${encodeURIComponent(`Hola, me gustaría cotizar una casa con Soluciones Integrales. Me interesa ${modelo.title}.`)}`} target="_blank" rel="noopener noreferrer" aria-label={`Cotizar un proyecto de ${modelo.title} por WhatsApp`}>Cotizar <span aria-hidden="true">↗</span></a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="feature-section" id="servicios" aria-labelledby="feature-title">
    <h2 id="feature-title" class="visually-hidden">Construcción de casas y radieres</h2>
    <div class="feature-grid">
      <a class="feature-card feature-card--primary" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero cotizar la construcción de una casa con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-casas.webp')} alt="" width="1122" height="1402" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Construimos<br />tu casa.</h3>
          <p>Casas tradicionales y modulares, pensadas para tu proyecto.</p>
          <span class="feature-action">Cotizar una casa <span aria-hidden="true">↗</span></span>
        </div>
      </a>
      <a class="feature-card feature-card--wide" href="#obras">
        <img src={asset('/images/servicio-modelos.webp')} alt="" width="1774" height="887" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Casas para<br />inspirarte.</h3>
          <span class="feature-action">Ver modelos <span aria-hidden="true">↗</span></span>
        </div>
      </a>
      <a class="feature-card feature-card--radier" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero cotizar la construcción de un radier con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-radieres.webp')} alt="" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Radieres.</h3>
          <span class="feature-action">Cotizar radier <span aria-hidden="true">↗</span></span>
        </div>
      </a>
      <a class="feature-card feature-card--contact" href={`${whatsapp}?text=${encodeURIComponent('Hola, quiero conversar sobre mi proyecto de construcción con Soluciones Integrales.')}`} target="_blank" rel="noopener noreferrer">
        <img src={asset('/images/servicio-contacto.webp')} alt="" width="1672" height="941" loading="lazy" decoding="async" />
        <div class="feature-content">
          <h3>Hablemos de<br />tu proyecto.</h3>
          <span class="feature-action">Escríbenos <span aria-hidden="true">↗</span></span>
        </div>
      </a>
    </div>
  </section>

  <script>
    const quoteForm = document.querySelector<HTMLFormElement>('#hero-quote-form');
    quoteForm?.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!quoteForm.reportValidity()) return;
      const type = quoteForm.querySelector<HTMLSelectElement>('#project-type')?.value.trim() ?? '';
      const location = quoteForm.querySelector<HTMLInputElement>('#project-location')?.value.trim() ?? '';
      const message = `Hola, quiero cotizar un proyecto con Soluciones Integrales. Tipo: ${type}. Comuna: ${location}.`;
      window.open(`https://wa.me/56935172731?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
    });

    const works = document.querySelector<HTMLElement>('#obras');
    const worksViewport = works?.querySelector<HTMLElement>('.works-viewport');
    const worksTrack = works?.querySelector<HTMLElement>('.works-track');
    const worksCurrent = document.querySelector<HTMLElement>('#works-current');
    if (works && worksViewport && worksTrack) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let travel = 0;
      let frame = 0;

      const update = () => {
        frame = 0;
        if (!works.classList.contains('is-scroll-driven')) return;
        const scrollable = Math.max(1, works.offsetHeight - window.innerHeight);
        const progress = Math.min(1, Math.max(0, -works.getBoundingClientRect().top / scrollable));
        worksTrack.style.transform = `translate3d(${-Math.round(travel * progress)}px, 0, 0)`;
        if (worksCurrent) worksCurrent.textContent = String(Math.min(worksTrack.children.length, Math.floor(progress * worksTrack.children.length) + 1)).padStart(2, '0');
      };

      const requestUpdate = () => {
        if (!frame) frame = window.requestAnimationFrame(update);
      };

      const measure = () => {
        if (reducedMotion.matches) {
          works.classList.remove('is-scroll-driven');
          works.style.removeProperty('--scroll-distance');
          worksTrack.style.removeProperty('transform');
          return;
        }
        works.classList.add('is-scroll-driven');
        travel = Math.max(0, worksTrack.scrollWidth - worksViewport.clientWidth);
        works.style.setProperty('--scroll-distance', `${Math.max(travel * 2.4, window.innerHeight * (worksTrack.children.length - 1))}px`);
        requestUpdate();
      };

      window.addEventListener('scroll', requestUpdate, { passive: true });
      window.addEventListener('resize', measure, { passive: true });
      reducedMotion.addEventListener('change', measure);
      window.requestAnimationFrame(measure);
    }
  </script>
</Layout>

<style>
  :global(body) { margin: 0; }
  :global(*:focus-visible) { outline: 3px solid #34475a; outline-offset: 3px; }
  main { background: #f8fafb; min-height: 100svh; padding: 16px clamp(16px, 3.5vw, 56px) 64px; }
  .hero-layout { max-width: 1424px; margin: 0 auto; }
  .hero { min-height: clamp(620px, 69vh, 740px); position: relative; isolation: isolate; overflow: hidden; border-radius: 24px; background: #9ec5e8; }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center center; z-index: -1; }
  .hero-content { padding: clamp(50px, 6vw, 100px) clamp(32px, 5.2vw, 84px) 126px; width: min(100%, 820px); }
  h1 { margin: 0; color: #17212a; font-size: clamp(54px, 6.3vw, 94px); font-weight: 500; letter-spacing: -.04em; line-height: 1.04; }
  h1 em { color: inherit; font-style: normal; font-weight: 750; }
  .hero-content p { margin: 26px 0 0; max-width: 44ch; color: #20303e; font-size: clamp(15px, 1.3vw, 18px); line-height: 1.5; font-weight: 500; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .button { display: inline-flex; align-items: center; justify-content: center; gap: 17px; min-height: 46px; padding: 12px 19px; border-radius: 8px; text-decoration: none; font-size: 13px; line-height: 1.2; font-weight: 700; transition: background-color 160ms ease, color 160ms ease, transform 160ms ease; }
  .button:hover { transform: translateY(-2px); }
  .button-dark { background: #18232d; color: #fff; }
  .button-dark:hover { background: #34475a; }
  .button-outline { border: 1.5px solid #20303e; color: #20303e; background: rgb(235 246 255 / .45); }
  .button-outline:hover { background: #f8fafb; }
  .button span { font-size: 18px; line-height: 0; }
  .hero-services { display: flex; align-items: center; flex-wrap: wrap; gap: 0; list-style: none; padding: 0; margin: clamp(42px, 6vh, 66px) 0 0; color: #20303e; font-size: 13px; font-weight: 700; }
  .hero-services li { padding: 0 16px; line-height: 1.4; border-left: 1px solid rgb(32 48 62 / .5); }
  .hero-services li:first-child { padding-left: 0; border-left: 0; }
  .quote-bar { width: min(850px, calc(100% - 36px)); margin: -61px auto 0; padding: 25px 28px 28px; position: relative; z-index: 2; border-radius: 14px; background: #fff; color: #17212a; box-shadow: 0 13px 25px rgb(16 35 52 / .13); }
  .quote-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 16px; }
  .quote-heading strong { font-size: 17px; font-weight: 700; letter-spacing: -.025em; }
  .quote-heading span { font-size: 12px; color: #5e6c77; }
  .quote-fields { display: grid; grid-template-columns: 1fr 1fr auto; gap: 10px; align-items: end; }
  .field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .field label { font-size: 11px; font-weight: 700; color: #344450; }
  .field select, .field input { height: 45px; width: 100%; min-width: 0; padding: 0 12px; border: 1px solid #ccd5dd; border-radius: 7px; color: #27333e; background: #fff; font: inherit; font-size: 13px; }
  .field select { cursor: pointer; }
  .field input::placeholder { color: #697985; opacity: 1; }
  .field :is(select, input):hover { border-color: #8d9ca8; }
  .quote-submit { display: inline-flex; justify-content: center; align-items: center; gap: 12px; height: 45px; padding: 0 18px; border: 0; border-radius: 7px; background: #18232d; color: #fff; font: inherit; font-size: 12px; font-weight: 700; white-space: nowrap; cursor: pointer; transition: background-color 160ms ease, transform 160ms ease; }
  .quote-submit:hover { background: #34475a; transform: translateY(-1px); }
  .quote-submit svg { width: 17px; height: 17px; }
  noscript a { display: inline-block; margin-top: 12px; font-size: 12px; color: #153e63; }
  .works { background: #f8fafb; color: #17212a; }
  .works-stage { min-height: 100svh; display: flex; align-items: center; }
  .works.is-scroll-driven { height: calc(100svh + var(--scroll-distance, 1500px)); }
  .works.is-scroll-driven .works-stage { position: sticky; top: 0; height: 100svh; min-height: 0; }
  .works-inner { width: 100%; max-width: 1536px; margin: 0 auto; padding: 65px clamp(20px, 3.5vw, 56px); display: grid; grid-template-columns: minmax(270px, .8fr) minmax(0, 1.5fr); gap: clamp(30px, 5vw, 80px); align-items: center; }
  .works-intro { min-width: 0; }
  .works h2 { max-width: 11ch; margin: 0 0 20px; font-size: clamp(42px, 4vw, 63px); font-weight: 500; letter-spacing: -.04em; line-height: 1.1; }
  .works h2 em { display: block; color: inherit; font-style: normal; font-weight: 700; letter-spacing: inherit; }
  .works-progress { display: flex; align-items: center; gap: 12px; margin-top: 0; color: #25313c; font-size: 12px; font-weight: 700; }
  .works-progress-line { display: block; width: 56px; height: 1px; background: #aab8c3; }
  .works-scroll-cue { display: inline-flex; align-items: center; gap: 10px; margin-top: 22px; color: #52606b; font-size: 11px; }
  .works-scroll-cue span { font-size: 20px; }
  .works-viewport { min-width: 0; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
  .works-viewport::-webkit-scrollbar { display: none; }
  .works.is-scroll-driven .works-viewport { overflow: hidden; scroll-snap-type: none; }
  .works-track { display: flex; align-items: stretch; width: max-content; padding: 21px 24px 34px 0; }
  .works.is-scroll-driven .works-track { will-change: transform; }
  .work-card { position: relative; flex: none; width: clamp(360px, 42vw, 630px); padding: 8px; overflow: hidden; border-radius: 16px; background: #fff; color: #17212a; box-shadow: 0 13px 25px rgb(16 35 52 / .13); scroll-snap-align: start; }
  .work-card + .work-card { margin-left: -48px; }
  .work-card img { display: block; width: 100%; aspect-ratio: 1.42; border-radius: 13px; object-fit: cover; }
  .work-card-caption { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 10px 14px; min-height: 110px; padding: 15px 18px 14px; }
  .work-card-number { align-self: start; padding-top: 5px; color: #77828b; font-size: 11px; font-weight: 800; }
  .work-card-detail { color: #697884; font-size: 10px; font-weight: 800; letter-spacing: .1em; }
  .work-card h3 { margin: 5px 0 0; font-size: clamp(18px, 1.6vw, 24px); font-weight: 700; letter-spacing: -.035em; line-height: 1.2; }
  .work-card a { display: inline-flex; grid-column: 2; justify-self: start; align-items: center; gap: 5px; min-height: 28px; margin-top: -4px; color: #17212a; font-size: 11px; font-weight: 800; text-decoration: none; white-space: nowrap; }
  .work-card a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .work-card a span { font-size: 17px; font-weight: 400; }
  .visually-hidden { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
  .feature-section { background: #f8fafb; padding: 86px clamp(16px, 3.5vw, 56px) 116px; }
  .feature-grid { max-width: 1424px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; grid-template-rows: 334px 242px; gap: 20px; }
  .feature-card { position: relative; isolation: isolate; display: block; overflow: hidden; min-width: 0; border-radius: 16px; background: #344450; color: #fff; text-decoration: none; }
  .feature-card--primary { grid-column: 1 / 3; grid-row: 1 / 3; }
  .feature-card--wide { grid-column: 3 / 5; }
  .feature-card--radier { grid-column: 3; }
  .feature-card--contact { grid-column: 4; }
  .feature-card img { position: absolute; inset: 0; z-index: -2; display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 450ms ease-out; }
  .feature-card:hover img { transform: scale(1.025); }
  .feature-card::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(90deg, rgb(13 24 32 / .8) 0%, rgb(13 24 32 / .54) 42%, rgb(13 24 32 / .14) 100%); }
  .feature-card--radier::before, .feature-card--contact::before { background: linear-gradient(90deg, rgb(13 24 32 / .82) 0%, rgb(13 24 32 / .52) 55%, rgb(13 24 32 / .14) 100%); }
  .feature-card--primary img { object-position: 60% center; }
  .feature-card--wide img { object-position: center center; }
  .feature-card--radier img { object-position: 57% center; }
  .feature-card--contact img { object-position: 58% center; }
  .feature-content { display: flex; flex-direction: column; align-items: flex-start; justify-content: flex-end; height: 100%; padding: clamp(26px, 3vw, 45px); }
  .feature-card--primary .feature-content, .feature-card--wide .feature-content { justify-content: center; }
  .feature-card h3 { max-width: 16ch; margin: 0; font-size: clamp(24px, 2.45vw, 39px); font-weight: 700; line-height: 1.12; letter-spacing: -.035em; text-wrap: balance; }
  .feature-card--primary h3 { font-size: clamp(40px, 4.1vw, 62px); }
  .feature-card p { max-width: 29ch; margin: 15px 0 0; font-size: clamp(13px, 1.1vw, 16px); font-weight: 500; line-height: 1.5; }
  .feature-action { display: inline-flex; align-items: center; justify-content: center; gap: 13px; min-height: 44px; margin-top: 22px; padding: 10px 15px; border-radius: 8px; background: #fff; color: #17212a; font-size: 12px; font-weight: 700; line-height: 1.2; }
  .feature-action span { font-size: 17px; font-weight: 400; }
  .feature-card:hover .feature-action { background: #eaf0f4; }
  .feature-card--radier .feature-content, .feature-card--contact .feature-content { padding: 25px; }
  .feature-card--radier h3, .feature-card--contact h3 { font-size: clamp(22px, 1.7vw, 27px); }
  .feature-card--radier .feature-action, .feature-card--contact .feature-action { margin-top: 14px; }
  @media (max-width: 900px) {
    .hero { min-height: 660px; }
    .hero-content { width: 65%; padding: 66px 40px 120px; }
    h1 { font-size: clamp(55px, 7.5vw, 75px); }
    .hero-photo { object-position: 58% center; }
    .works-inner { grid-template-columns: minmax(210px, .75fr) minmax(0, 1.4fr); gap: 27px; }
    .works h2 { font-size: clamp(38px, 5vw, 48px); }
    .work-card { width: min(54vw, 500px); }
    .feature-grid { grid-template-rows: 300px 220px; gap: 14px; }
    .feature-card--radier .feature-content, .feature-card--contact .feature-content { padding: 20px; }
    .feature-card--radier h3, .feature-card--contact h3 { font-size: 21px; }
  }
  @media (max-width: 760px) {
    .works-inner { display: block; padding: 32px 0 30px 18px; }
    .works-intro { padding-right: 18px; margin-bottom: 22px; }
    .works h2 { max-width: 11ch; margin: 0 0 12px; font-size: clamp(35px, 9vw, 43px); }
    .works-progress { margin-top: 0; }
    .works-scroll-cue { margin-top: 8px; }
    .work-card { width: min(78vw, 320px); padding: 7px; border-radius: 16px; }
    .work-card + .work-card { margin-left: -27px; }
    .work-card img { aspect-ratio: 1.25; border-radius: 12px; }
    .work-card-caption { min-height: 83px; padding: 11px 10px; gap: 9px; }
    .work-card h3 { font-size: 17px; }
    .work-card a { min-height: 27px; margin-top: -3px; font-size: 10px; }
    .feature-section { padding: 44px 16px 68px; }
    .feature-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; gap: 12px; }
    .feature-card--primary, .feature-card--wide { grid-column: 1 / -1; grid-row: auto; }
    .feature-card--radier { grid-column: 1; grid-row: auto; }
    .feature-card--contact { grid-column: 2; grid-row: auto; }
    .feature-card--primary { min-height: 390px; }
    .feature-card--wide { min-height: 245px; }
    .feature-card--radier, .feature-card--contact { min-height: 212px; }
    .feature-card--primary .feature-content, .feature-card--wide .feature-content { justify-content: flex-end; }
    .feature-card--primary .feature-content, .feature-card--wide .feature-content { padding: 25px; }
