---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Soluciones Integrales | Construcción en Angol",
  description = "Construcción de casas, quinchos y radieres en Angol y La Araucanía.",
} = Astro.props;

const canonical = Astro.url.href;
const socialImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/hero-casa-chilena.webp`, Astro.site).href;
---

<!doctype html>
<html lang="es" class="h-full antialiased bg-[#f8f6f0] text-[#171916]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0f0d" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=REM:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>body { font-family: 'REM', sans-serif; }</style>
  </head>
  <body class="min-h-full flex flex-col bg-[#f8f6f0] selection:bg-[#f3bd1c] selection:text-[#171916]">
    <slot />
  </body>
</html>
