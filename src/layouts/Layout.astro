---
import '../styles/global.css';
import { buildStructuredData, canonicalUrl, serializeSchema } from '../lib/seo';
import type { Service } from '../data/services';

interface Props {
  title?: string;
  description?: string;
  service?: Service;
}

const { 
  title = "Soluciones Integrales | Construcción en todo Chile",
  description = "Construcción de casas, quinchos y radieres en todo Chile. Nos trasladamos al lugar de tu proyecto.",
  service,
} = Astro.props;

const canonical = canonicalUrl(Astro.url.pathname, Astro.site!);
const home = canonicalUrl(import.meta.env.BASE_URL, Astro.site!);
const socialImage = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/images/hero-casa-chilena.webp`, Astro.site).href;
const structuredData = buildStructuredData({home, canonical, title, description, image: socialImage, service});
---

<!doctype html>
<html lang="es-CL" class="h-full antialiased bg-white text-[#171916]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0d0f0d" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="Soluciones Integrales" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1672" />
    <meta property="og:image:height" content="940" />
    <meta property="og:image:alt" content="Imagen ilustrativa de una casa contemporánea; Soluciones Integrales, construcción en todo Chile" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={serializeSchema(structuredData)} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=REM:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>body { font-family: 'REM', sans-serif; }</style>
  </head>
  <body class="min-h-full flex flex-col bg-white selection:bg-[#f3bd1c] selection:text-[#171916]">
    <slot />
  </body>
</html>
