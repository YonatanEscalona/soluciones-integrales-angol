---
const whatsapp = 'https://wa.me/56935172731';
---

<section class="budget-section" id="contacto" aria-labelledby="budget-title">
  <div class="budget-inner">
    <div class="budget-intro">
      <h2 id="budget-title">Conversemos sobre <strong>tu proyecto.</strong></h2>
      <p>Solicita un presupuesto para tu casa, quincho o radier. Cuéntanos qué necesitas y dónde quieres construir.</p>
      <dl class="contact-details">
        <div><dt>Teléfono y WhatsApp</dt><dd><a href={whatsapp} target="_blank" rel="noopener noreferrer">+56 9 3517 2731</a></dd></div>
        <div><dt>Correo</dt><dd><a href="mailto:mauricioeazocar@gmail.com">mauricioeazocar@gmail.com</a></dd></div>
        <div><dt>Dirección</dt><dd>Cerro Negro #1388, Angol<br />La Araucanía, Chile</dd></div>
        <div><dt>Horario de contacto</dt><dd>24/7</dd></div>
      </dl>
      <a class="contact-map" href="https://www.google.com/maps/search/?api=1&query=Cerro+Negro+1388+Angol+Chile" target="_blank" rel="noopener noreferrer">Ver ubicación</a>
    </div>
    <form class="budget-form" id="budget-form" aria-label="Solicitud de presupuesto">
      <h3>Solicita tu presupuesto</h3>
      <p class="form-intro">Los campos con * son obligatorios.</p>
      <div class="budget-fields">
        <div><label for="budget-name">Nombre completo *</label><input id="budget-name" name="name" autocomplete="name" maxlength="100" required /></div>
        <div><label for="budget-phone">Teléfono *</label><input id="budget-phone" name="phone" type="tel" autocomplete="tel" placeholder="+56 9…" minlength="8" maxlength="24" required /></div>
        <div class="full"><label for="budget-email">Correo electrónico <span>(opcional)</span></label><input id="budget-email" name="email" type="email" autocomplete="email" maxlength="120" placeholder="tu@correo.cl" /></div>
        <div><label for="budget-service">Tipo de proyecto *</label><select id="budget-service" name="service" required><option value="" disabled selected>Seleccionar</option><option>Casa llave en mano</option><option>Casa tradicional</option><option>Casa modular</option><option>Quincho</option><option>Radier</option><option>Remodelación o terminaciones</option><option>Electricidad o gasfitería</option><option>Otro proyecto</option></select></div>
        <div><label for="budget-town">Comuna *</label><input id="budget-town" name="town" autocomplete="address-level2" placeholder="Ej. Angol" maxlength="80" required /></div>
        <div class="full"><label for="budget-amount">Presupuesto disponible en CLP <span>(opcional)</span></label><input id="budget-amount" name="amount" type="number" inputmode="numeric" min="0" max="10000000000" step="1" placeholder="Monto aproximado en pesos" /></div>
        <div class="full"><label for="budget-description">Cuéntanos tu idea <span>(opcional)</span></label><textarea id="budget-description" name="description" rows="4" maxlength="1200" placeholder="Medidas, tipo de terreno, materiales o lo que imaginas para tu proyecto…"></textarea></div>
      </div>
      <button class="budget-submit" type="submit" disabled>Solicitar presupuesto por WhatsApp</button>
      <p class="form-note">Se abrirá WhatsApp con tu solicitud para que la revises y la envíes.</p>
      <p id="budget-status" class="form-status" role="status"></p>
      <a id="budget-fallback" class="contact-map" href={whatsapp} target="_blank" rel="noopener noreferrer" hidden>Abrir solicitud en WhatsApp</a>
      <noscript><a class="contact-map" href={whatsapp}>Solicita tu presupuesto directamente por WhatsApp.</a></noscript>
    </form>
  </div>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('#budget-form');
  if (form) {
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const phone = form.querySelector<HTMLInputElement>('#budget-phone')!;
    button.disabled = false;
    phone.addEventListener('input', () => phone.setCustomValidity(''));
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      if (!/^\+?\d{8,15}$/.test(phone.value.replace(/[\s()-]/g, ''))) {
        phone.setCustomValidity('Ingresa un teléfono válido, por ejemplo +56 9 1234 5678.');
      }
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const value = (key: string) => String(data.get(key) ?? '').trim();
      const amount = value('amount');
      const budget = amount ? new Intl.NumberFormat('es-CL', {style: 'currency', currency: 'CLP', maximumFractionDigits: 0}).format(Number(amount)) : 'Por definir';
      const message = ['Hola, quiero solicitar un presupuesto con Soluciones Integrales.', '', `Nombre: ${value('name')}`, `Teléfono: ${value('phone')}`, ...(value('email') ? [`Correo: ${value('email')}`] : []), `Proyecto: ${value('service')}`, `Comuna: ${value('town')}`, `Presupuesto disponible: ${budget}`, ...(value('description') ? [`Mi idea: ${value('description')}`] : [])].join('\n');
      const href = `https://wa.me/56935172731?text=${encodeURIComponent(message)}`;
      const fallback = form.querySelector<HTMLAnchorElement>('#budget-fallback')!;
      fallback.href = href;
      fallback.hidden = false;
      form.querySelector<HTMLElement>('#budget-status')!.textContent = 'Tu solicitud está preparada. Si WhatsApp no se abre, utiliza el enlace de abajo.';
      window.open(href, '_blank', 'noopener,noreferrer');
    });
  }
</script>

<style>
  .budget-section { padding: 80px clamp(16px, 3.5vw, 56px); background: var(--ink); color: #fff; scroll-margin-top: 24px; }
  .budget-inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: clamp(40px, 7vw, 110px); max-width: 1424px; margin: 0 auto; }
  .budget-intro h2 { max-width: 13ch; margin: 0; font-size: clamp(38px, 4vw, 60px); line-height: 1.08; letter-spacing: -.04em; font-weight: 500; }
  .budget-intro strong { display: block; color: var(--yellow); font-weight: 700; }
  .budget-intro > p { max-width: 39ch; margin: 24px 0 35px; color: #d5d8d2; font-size: 15px; line-height: 1.65; }
  .contact-details { margin: 0; display: grid; gap: 23px; }
  .contact-details div { min-width: 0; }
  dt { margin-bottom: 6px; font-size: 12px; color: #d5d8d2; }
  dd { margin: 0; font-size: 16px; line-height: 1.5; }
  dd a { color: #fff; text-decoration: none; overflow-wrap: anywhere; }
  dd a:hover { text-decoration: underline; text-underline-offset: 4px; }
  .contact-map { display: inline-block; min-height: 44px; margin-top: 18px; padding-block: 10px; color: var(--yellow); font-size: 13px; font-weight: 600; text-underline-offset: 5px; }
  .contact-map[hidden] { display: none; }
  .budget-form h3 { margin: 0; font-size: 26px; letter-spacing: -.025em; font-weight: 600; }
  .form-intro { margin: 9px 0 25px; color: #d5d8d2; font-size: 12px; }
  .budget-fields { display: grid; grid-template-columns: 1fr 1fr; gap: 19px 15px; }
  .budget-fields > div { min-width: 0; }
  .full { grid-column: 1 / -1; }
  label { display: block; margin-bottom: 8px; font-size: 12px; font-weight: 600; }
  label span { font-size: 11px; color: #d5d8d2; font-weight: 400; }
  input, select, textarea { display: block; width: 100%; min-width: 0; min-height: 46px; padding: 11px 13px; border: 1px solid #62665f; border-radius: 7px; background: var(--ink-raised); color: #fff; font: inherit; font-size: 14px; line-height: 1.5; caret-color: var(--yellow); }
  input::placeholder, textarea::placeholder { color: #babeb5; opacity: 1; }
  select { cursor: pointer; }
  textarea { resize: vertical; }
  :is(input, select, textarea):hover { border-color: #949a8e; }
  .budget-section :is(input, select, textarea, a, button):focus-visible { outline-color: var(--yellow); }
  .budget-submit { display: block; width: 100%; min-height: 48px; margin-top: 23px; padding: 12px 18px; border: 0; border-radius: 8px; background: var(--yellow); color: var(--ink); font: inherit; font-size: 13px; font-weight: 700; cursor: pointer; transition: background-color 180ms ease-out; }
  .budget-submit:hover { background: var(--yellow-bright); }
  .budget-submit:disabled { opacity: .5; cursor: default; }
  .form-note, .form-status { margin: 11px 0 0; color: #d5d8d2; font-size: 11px; line-height: 1.6; }
  @media(max-width: 700px) {
    .budget-section { padding: 52px 20px; }
    .budget-inner { grid-template-columns: 1fr; gap: 43px; }
    .budget-intro h2 { font-size: 39px; }
    .budget-intro > p { margin: 19px 0 27px; font-size: 14px; }
    .contact-details { grid-template-columns: 1fr 1fr; gap: 20px; }
    .contact-details > div:nth-child(2) { grid-column: 1 / -1; grid-row: 2; }
    dd { font-size: 14px; }
    .budget-form { padding-top: 30px; border-top: 1px solid #484d43; }
    .budget-fields { grid-template-columns: 1fr; gap: 16px; }
    input, select, textarea { font-size: 16px; }
    .budget-fields > div:nth-child(-n+2) { grid-column: 1 / -1; }
    .budget-submit { font-size: 12px; }
  }
  @media(prefers-reduced-motion: reduce) { .budget-submit { transition: none; } }
</style>
