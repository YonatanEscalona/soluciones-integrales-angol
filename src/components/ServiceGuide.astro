---
import { services } from '../data/services';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="service-guide" aria-labelledby="service-guide-title">
  <div class="guide-inner">
    <div class="guide-intro"><h2 id="service-guide-title">Tu proyecto, con las cosas claras.</h2><p>Construcción de casas y mejoras de viviendas en Angol y La Araucanía. Conoce cada servicio y qué información necesitamos para preparar tu cotización.</p></div>
    <div class="guide-links">
      {services.map(service => <a href={`${base}/servicios/${service.slug}/`}><h3>{service.name}</h3><p>{service.summary}</p><span>Conocer el servicio</span></a>)}
    </div>
  </div>
</section>

<style>
  .service-guide { background: var(--paper); padding: 0 clamp(20px, 3.5vw, 56px) 80px; color: var(--ink); }
  .guide-inner { max-width: 1424px; margin: 0 auto; padding-top: 44px; border-top: 1px solid var(--line); }
  .guide-intro { display: flex; justify-content: space-between; align-items: baseline; gap: 36px; margin-bottom: 30px; }
  h2 { max-width: 17ch; margin: 0; font-size: clamp(30px, 3.2vw, 44px); line-height: 1.12; letter-spacing: -.04em; font-weight: 600; }
  .guide-intro p { max-width: 52ch; margin: 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
  .guide-links { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .guide-links a { display: block; padding: 25px 0; border-bottom: 1px solid var(--line); color: inherit; text-decoration: none; }
  h3 { margin: 0; font-size: 21px; font-weight: 600; letter-spacing: -.025em; }
  .guide-links p { max-width: 50ch; margin: 12px 0 16px; color: var(--muted); font-size: 14px; line-height: 1.65; }
  .guide-links span { display: inline-block; font-size: 12px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--yellow); text-decoration-thickness: 2px; }
  .guide-links a:hover span { text-decoration-color: var(--ink); }
  @media (max-width: 760px) { .service-guide { padding-bottom: 48px; } .guide-inner { padding-top: 32px; } .guide-intro { display: block; } .guide-intro p { margin-top: 18px; } .guide-links { grid-template-columns: 1fr; } h3 { font-size: 19px; } }
</style>
