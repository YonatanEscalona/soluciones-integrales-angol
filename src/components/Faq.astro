---
interface Props {
  questions: {question: string; answer: string}[];
  title?: string;
  id?: string;
}
const {questions, title = 'Antes de empezar tu proyecto.', id = 'preguntas'} = Astro.props;
---

<section class="faq" aria-labelledby={`${id}-title`} id={id}>
  <div class="faq-inner">
    <div class="faq-intro"><span>Preguntas frecuentes</span><h2 id={`${id}-title`}>{title}</h2></div>
    <div class="faq-list">
      {questions.map(({question, answer}) => <details><summary>{question}<span aria-hidden="true" class="faq-indicator"></span></summary><p>{answer}</p></details>)}
    </div>
  </div>
</section>

<style>
  .faq { padding: 80px clamp(20px, 3.5vw, 56px); background: var(--paper); color: var(--ink); }
  .faq-inner { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 90px); max-width: 1424px; margin: 0 auto; }
  .faq-intro > span { font-size: 12px; font-weight: 600; color: var(--muted); }
  h2 { margin: 16px 0 0; max-width: 16ch; font-size: clamp(30px, 3.6vw, 48px); font-weight: 600; letter-spacing: -.04em; line-height: 1.12; }
  details { border-top: 1px solid var(--line); }
  details:last-child { border-bottom: 1px solid var(--line); }
  summary { display: flex; align-items: center; justify-content: space-between; gap: 22px; min-height: 64px; padding: 19px 0; list-style: none; font-size: 15px; font-weight: 600; line-height: 1.5; cursor: pointer; }
  summary::-webkit-details-marker { display: none; }
  .faq-indicator { position: relative; flex: none; width: 16px; height: 16px; }
  .faq-indicator::before, .faq-indicator::after { position: absolute; content: ''; top: 7px; left: 1px; width: 14px; height: 2px; background: currentColor; }
  .faq-indicator::after { transform: rotate(90deg); }
  details[open] .faq-indicator::after { display: none; }
  p { margin: 0; padding: 0 28px 22px 0; font-size: 14px; line-height: 1.75; color: var(--muted); }
  @media (max-width: 760px) { .faq { padding-block: 48px; } .faq-inner { grid-template-columns: 1fr; gap: 28px; } summary { font-size: 14px; } }
</style>
