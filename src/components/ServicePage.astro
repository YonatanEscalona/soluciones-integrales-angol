---
import Layout from '../layouts/Layout.astro';
import Faq from './Faq.astro';
import { business } from '../data/business';
import { services, type Service } from '../data/services';
interface Props { service: Service; }
const {service} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const home = `${base}/`;
const quote = `${business.whatsapp}?text=${encodeURIComponent(service.quote)}`;
const isRadier = service.slug === 'radieres-angol';
const plannerHref = `${home}#${isRadier ? 'contacto' : service.planner}`;
const plannerLabel = isRadier ? 'Preparar mi solicitud' : service.planner === 'planifica' ? 'Planificar mi casa' : 'Planificar una mejora';
const imageCaption = service.slug === 'remodelaciones-angol' ? 'Fotografía del portafolio de Soluciones Integrales, mejorada con IA.' : 'Imagen referencial para conversar sobre tu proyecto.';
---

<Layout title={service.title} description={service.description} service={service}>
  <a class="skip-link" href="#contenido">Ir al contenido</a>
  <header class="service-header">
    <div class="header-inner">
      <a class="brand" href={home} aria-label="Soluciones Integrales, inicio"><img src={`${base}/images/logo-soluciones-integrales.png`} alt="" width="640" height="514" /><span><strong>Soluciones Integrales</strong><small>Construcción de casas · Angol</small></span></a>
      <nav aria-label="Navegación principal"><a href={`${home}#servicios`}>Servicios</a><a href={`${home}#contacto`}>Contacto</a></nav>
      <a class="header-quote" href={quote} target="_blank" rel="noopener noreferrer" aria-label="Cotizar por WhatsApp"><span class="quote-full">Cotizar por WhatsApp</span><span class="quote-short" aria-hidden="true">WhatsApp</span></a>
    </div>
  </header>
  <main id="contenido">
    <section class="service-hero" aria-labelledby="service-title">
      <div class="hero-copy">
        <nav class="breadcrumbs" aria-label="Ruta de navegación"><ol><li><a href={home}>Inicio</a></li><li aria-current="page">{service.name}</li></ol></nav>
        <h1 id="service-title">{service.heading}</h1>
        <p>{service.intro}</p>
        <div class="actions"><a class="button primary" href={quote} target="_blank" rel="noopener noreferrer">Cotizar por WhatsApp</a><a class="text-link" href={plannerHref}>{plannerLabel}</a></div>
        <span class="hero-note">Cuéntanos la comuna y las medidas aproximadas para comenzar.</span>
      </div>
      <figure><img src={`${base}${service.image}`} alt={service.imageAlt} width={service.slug === 'construccion-casas-angol' ? 1122 : service.slug === 'remodelaciones-angol' ? 1763 : service.slug === 'radieres-angol' ? 1672 : 1536} height={service.slug === 'construccion-casas-angol' ? 1402 : service.slug === 'remodelaciones-angol' ? 892 : service.slug === 'radieres-angol' ? 941 : 1024} loading="eager" decoding="async" /><figcaption>{imageCaption}</figcaption></figure>
    </section>
    <section class="scope section-wrap" aria-labelledby="scope-title"><h2 id="scope-title">{service.scopeTitle}</h2><div class="scope-grid">{service.scope.map((item, index) => <article><span class="item-number">0{index + 1}</span><h3>{item.title}</h3><p>{item.text}</p></article>)}</div></section>
    <section class="preparation section-wrap" aria-labelledby="preparation-title"><div><span class="eyebrow">Para solicitar tu presupuesto</span><h2 id="preparation-title">Esto nos ayuda a cotizar.</h2><p>No necesitas tener todo resuelto. Comparte los datos que conoces y conversemos sobre lo que falta definir.</p><a class="button primary" href={quote} target="_blank" rel="noopener noreferrer">Conversar sobre mi proyecto</a></div><ol>{service.preparation.map(item => <li>{item}</li>)}</ol></section>
    <section class="considerations section-wrap" aria-label="Aspectos que revisamos en tu proyecto">{service.considerations.map(item => <article><h2>{item.title}</h2><p>{item.text}</p></article>)}</section>
    <Faq questions={service.questions} title="Resolvamos tus primeras dudas." />
    <section class="closing section-wrap" aria-labelledby="closing-title"><div><h2 id="closing-title">Demos el primer paso.</h2><p>Cuéntanos qué quieres hacer y dónde. Revisaremos los datos para definir el alcance de tu proyecto.</p></div><a class="button primary" href={quote} target="_blank" rel="noopener noreferrer">Solicitar mi presupuesto</a></section>
    <nav class="other-services section-wrap" aria-label="Otros servicios de construcción"><h2>También podemos ayudarte con</h2><ul>{services.filter(item => item.slug !== service.slug).map(item => <li><a href={`${base}/servicios/${item.slug}/`}>{item.name}</a></li>)}</ul></nav>
  </main>
  <footer><div class="footer-inner"><div><strong>{business.name}</strong><p>Construcción de casas, quinchos, radieres y remodelaciones.</p><address>{business.streetAddress}, {business.city}<br />{business.region}, Chile</address></div><div class="footer-contact"><a href={business.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp {business.phoneDisplay}</a><a href={`mailto:${business.email}`}>{business.email}</a><a href={business.originalWebsite} target="_blank" rel="noopener noreferrer">Otros servicios de Soluciones Integrales</a></div></div></footer>
</Layout>

<style>
  .skip-link { position: absolute; top: 8px; left: 8px; z-index: 100; padding: 12px; background: var(--yellow); color: var(--ink); transform: translateY(-180%); }
  .skip-link:focus { transform: none; }
  .service-header, footer { background: #0d0f0d; color: #fff; }
  .header-inner { max-width: 1536px; margin: auto; padding: 12px clamp(20px, 3.5vw, 56px); display: flex; align-items: center; gap: 32px; }
  .brand { display: flex; align-items: center; gap: 10px; margin-right: auto; text-decoration: none; color: #fff; }
  .brand img { width: 59px; height: 50px; object-fit: contain; }
  .brand span { display: flex; flex-direction: column; gap: 4px; }
  .brand strong { font-size: 16px; letter-spacing: -.03em; line-height: 1.2; }
  .brand small { font-size: 10px; }
  .service-header nav { display: flex; gap: 24px; }
  .service-header nav a { display: inline-flex; align-items: center; min-height: 44px; font-size: 13px; color: #fff; text-decoration: none; }
  .header-quote { display: flex; align-items: center; min-height: 44px; padding: 12px 17px; border-radius: 8px; color: var(--ink); background: var(--yellow); text-decoration: none; font-size: 12px; font-weight: 700; }
  .quote-short { display: none; }
  .service-header a:focus-visible, footer a:focus-visible { outline-color: var(--yellow); }
  main { color: var(--ink); }
  .section-wrap, .service-hero { max-width: 1536px; margin-inline: auto; padding-inline: clamp(20px, 3.5vw, 56px); }
  .service-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, .85fr); gap: clamp(36px, 6vw, 90px); align-items: center; padding-block: 48px 64px; }
  .breadcrumbs ol { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 35px; padding: 0; list-style: none; color: var(--muted); font-size: 12px; line-height: 1.7; }
  .breadcrumbs li + li::before { content: '/'; margin-right: 8px; }
  .breadcrumbs a { color: inherit; text-underline-offset: 3px; }
  h1 { max-width: 15ch; margin: 0; font-size: clamp(38px, 4.4vw, 66px); font-weight: 600; letter-spacing: -.045em; line-height: 1.07; }
  .hero-copy > p { max-width: 53ch; margin: 25px 0 0; font-size: 16px; line-height: 1.75; color: var(--muted); }
  .actions { display: flex; align-items: center; flex-wrap: wrap; gap: 16px 24px; margin-top: 28px; }
  .button { display: inline-flex; justify-content: center; align-items: center; min-height: 48px; padding: 13px 20px; border-radius: 8px; font-size: 13px; font-weight: 700; line-height: 1.4; text-align: center; text-decoration: none; }
  .primary { background: var(--yellow); color: var(--ink); transition: background-color 180ms ease-out; }
  .primary:hover, .header-quote:hover { background: var(--yellow-bright); }
  .text-link { padding-block: 12px; color: var(--ink); font-size: 13px; font-weight: 600; text-underline-offset: 5px; }
  .hero-note { display: block; margin-top: 18px; max-width: 48ch; color: var(--muted); font-size: 12px; line-height: 1.7; }
  figure { min-width: 0; margin: 0; }
  figure img { display: block; width: 100%; height: 410px; object-fit: cover; border-radius: 16px; }
  figcaption { margin-top: 10px; color: var(--muted); font-size: 11px; line-height: 1.6; }
  h2 { margin: 0; max-width: 22ch; font-size: clamp(28px, 3vw, 40px); line-height: 1.15; font-weight: 600; letter-spacing: -.035em; }
  h3 { font-weight: 600; letter-spacing: -.025em; }
  .scope { padding-block: 32px 72px; }
  .scope-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; margin-top: 36px; }
  .scope article { padding-top: 22px; border-top: 1px solid var(--line); }
  .item-number { display: block; font-size: 12px; color: var(--muted); }
  .scope h3 { margin: 20px 0 12px; font-size: 20px; line-height: 1.3; }
  .scope p, .considerations p, .preparation p, .closing p { margin: 0; font-size: 14px; line-height: 1.8; color: var(--muted); }
  .preparation { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(36px, 6vw, 90px); padding-block: 56px; background: var(--ink); color: #fff; border-radius: 16px; max-width: 1424px; }
  .eyebrow { display: block; margin-bottom: 18px; font-size: 12px; color: var(--yellow); }
  .preparation p { max-width: 48ch; margin-top: 22px; color: #d5d8d2; }
  .preparation .button { margin-top: 24px; }
  .preparation ol { margin: 0; padding-left: 22px; display: grid; align-content: center; gap: 20px; }
  .preparation li { padding-left: 8px; font-size: 14px; line-height: 1.75; }
  .preparation li::marker { color: var(--yellow); }
  .preparation a:focus-visible { outline-color: var(--yellow); }
  .considerations { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(32px, 6vw, 90px); padding-block: 72px 0; }
  .considerations h2 { font-size: 27px; margin-bottom: 20px; }
  .closing { display: flex; align-items: center; justify-content: space-between; gap: 32px; padding-block: 44px; border-block: 1px solid var(--line); }
  .closing p { max-width: 62ch; margin-top: 16px; }
  .closing .button { flex: none; }
  .other-services { padding-block: 44px 64px; }
  .other-services h2 { font-size: 20px; max-width: none; }
  .other-services ul { display: flex; flex-wrap: wrap; gap: 12px 28px; margin: 22px 0 0; padding: 0; list-style: none; }
  .other-services a { display: inline-block; min-height: 44px; padding-block: 10px; color: var(--ink); font-size: 14px; text-underline-offset: 5px; }
  footer { padding: 48px clamp(20px, 3.5vw, 56px); }
  .footer-inner { display: flex; justify-content: space-between; gap: 36px; max-width: 1424px; margin: auto; }
  footer strong { font-size: 19px; }
  footer p, address { margin: 12px 0 0; color: #d5d8d2; font-size: 13px; line-height: 1.7; font-style: normal; }
  .footer-contact { display: flex; flex-direction: column; align-items: flex-start; }
  footer a { padding-block: 10px; min-height: 44px; color: #fff; font-size: 13px; text-underline-offset: 4px; overflow-wrap: anywhere; }
  @media (max-width: 900px) { .service-header nav { display: none; } .service-hero { gap: 32px; } figure img { height: 380px; } .preparation { border-radius: 0; } }
  @media (max-width: 640px) {
    .header-inner { padding-block: 10px; gap: 12px; flex-wrap: wrap; }
    .brand strong { font-size: 14px; } .brand img { width: 44px; height: 40px; } .brand small { font-size: 9px; }
    .header-quote { font-size: 10px; padding: 10px 12px; }
    .quote-full { display: none; } .quote-short { display: inline; }
    .service-hero { grid-template-columns: 1fr; padding-block: 28px 40px; gap: 28px; }
    .breadcrumbs ol { margin-bottom: 25px; font-size: 11px; }
    .hero-copy > p { font-size: 14px; margin-top: 20px; }
    .actions { margin-top: 24px; gap: 6px 20px; }
    figure img { height: 240px; border-radius: 10px; }
    .scope { padding-block: 20px 40px; } .scope-grid { grid-template-columns: 1fr; gap: 22px; margin-top: 25px; }
    .scope h3 { margin-top: 12px; }
    .preparation { grid-template-columns: 1fr; padding-block: 36px; gap: 30px; }
    .considerations { grid-template-columns: 1fr; padding-top: 44px; gap: 32px; }
    .considerations h2 { font-size: 25px; }
    .closing { align-items: flex-start; flex-direction: column; padding-block: 36px; gap: 22px; }
    .other-services { padding-block: 36px; } .other-services ul { flex-direction: column; gap: 2px; }
    .footer-inner { flex-direction: column; gap: 24px; }
  }
  @media (max-width: 360px) { .header-inner { gap: 8px; padding-inline: 16px; } .brand { gap: 8px; } .brand img { width: 40px; } .brand strong { font-size: 13px; } .brand small { font-size: 8px; } }
</style>
